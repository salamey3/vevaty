-    [resolvedAttrs, attrValues]
+    () => resolveVisibleAttrs(resolvedAttrs.filter((a) => !a.isVariant), attrValues, listing?.condition),
+    [resolvedAttrs, attrValues, listing?.condition]
   );
   const hasSpecs = specAttrs.length > 0;
 
