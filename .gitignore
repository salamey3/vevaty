# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# hosting details for the automatic website upload -- describes one
# person's account, and this repo is public. Copy deploy.config.example.json
# to create it. No password lives in it; scp uses your SSH key.
deploy.config.json

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Scratch folder for files the cloud assistant can't delete directly (its
# mount refuses unlink, so anything it needs to remove gets moved here for
# you to bin later). Ignored so a leftover never blocks `npm run ship`,
# which refuses to run while `git status --porcelain` reports anything.
_to_delete/
